{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "definition_manifest",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "definition_id",
    "content_sha256",
    "generator",
    "application_revision",
    "mapping_version",
    "tasks",
    "stage_definitions",
    "product_rule_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "kind": {
      "const": "definition_manifest"
    },
    "definition_id": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generator": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "application_revision": {
      "type": "string",
      "minLength": 1
    },
    "mapping_version": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_key",
          "task_kind",
          "stage_key",
          "parameters",
          "engine_path_template",
          "depends_on"
        ],
        "properties": {
          "task_key": {
            "type": "string",
            "minLength": 1
          },
          "task_kind": {
            "type": "string",
            "minLength": 1
          },
          "stage_key": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "type",
                "required"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "string",
                    "integer",
                    "boolean"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "default": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer",
                      "minimum": -9223372036854775808,
                      "maximum": 9223372036854775807
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "enum": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer",
                        "minimum": -9223372036854775808,
                        "maximum": 9223372036854775807
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "engine_path_template": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "stage_definitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "product_rule_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
