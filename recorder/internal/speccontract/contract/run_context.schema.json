{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "run_context",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "registry_id",
    "run_id",
    "request_sha256",
    "launch_token_sha256",
    "system_id",
    "purpose",
    "deployment_id",
    "platform_id",
    "cycle",
    "definition_ref",
    "expectation_ref",
    "config_refs",
    "scope",
    "context_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "kind": {
      "const": "run_context"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "launch_token_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "system_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "deployment_id": {
      "type": "string",
      "minLength": 1
    },
    "platform_id": {
      "type": "string",
      "minLength": 1
    },
    "cycle": {
      "type": "object",
      "required": [
        "cycle_time",
        "cycle_kind"
      ],
      "properties": {
        "cycle_time": {
          "type": "string",
          "format": "date-time"
        },
        "cycle_kind": {
          "enum": [
            "forecast",
            "assimilation"
          ]
        }
      },
      "additionalProperties": false
    },
    "definition_ref": {
      "type": "object",
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "expectation_ref": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "config_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "task_key",
          "parameters"
        ],
        "properties": {
          "task_key": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": -9223372036854775808,
                  "maximum": 9223372036854775807
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rerun_of": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^run_[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
