{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "attempt_context",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "run_id",
    "run_context_sha256",
    "task_key",
    "parameters",
    "task_instance_id",
    "attempt_id",
    "execution_token_sha256",
    "retry_of",
    "process_role",
    "context_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "kind": {
      "const": "attempt_context"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{64}$"
    },
    "run_context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_key": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "integer",
            "minimum": -9223372036854775808,
            "maximum": 9223372036854775807
          },
          {
            "type": "boolean"
          }
        ]
      }
    },
    "task_instance_id": {
      "type": "string",
      "pattern": "^ti_[0-9a-f]{64}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^att_[0-9a-f]{64}$"
    },
    "execution_token_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "retry_of": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^att_[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "process_role": {
      "type": "string",
      "minLength": 1
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
